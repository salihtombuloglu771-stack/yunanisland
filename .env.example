# Supabase — Proje Ayarları > API sayfasından alınır
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxx
# Gizli tutulmalı — sadece sunucu tarafında kullanılır, asla client'a gönderilmez
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxx

# Uygulamanın gerçek adresi
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Aşağıdakiler henüz kurulmadı, ilgili özellik hayata geçirilirken eklenecek ---

# Ödeme (Premium üyelik fazında)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# AI özellikleri (Trip Planner, Travel Assistant fazında)
# OPENAI_API_KEY=

# Hava durumu (Live Weather fazında)
# WEATHER_API_KEY=
